---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar';
import Footer from '../components/sections/Footer.astro';
import HeroViewer from '../components/interactive/HeroViewer.tsx';
---

<Layout title="VECTOR | Levantamiento Digital y Escaneo 3D Industrial">
  
  <Navbar client:load />

  <main>
    <section class="hero" id="inicio">
      <div class="hero-glow"></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-dot"></span>
            Ingeniería de captura digital
            <span class="eyebrow-line"></span>
            01
          </div>

          <h1>
            Levantamiento digital y escaneo 3D de <span>alta precisión.</span>
          </h1>

          <p class="subtitle">
            Convertimos plantas industriales e infraestructuras reales en modelos 3D y planos <strong>As-Built exactos</strong> con Matterport Pro3 y AutoCAD.
          </p>

          <div class="cta-row">
            <a href="/contacto" class="button primary-button">
              Solicitar levantamiento
              <svg aria-hidden="true" fill="none" height="19" viewBox="0 0 24 24" width="19"><g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></g></svg>
            </a>
            <a href="/showcase" class="button secondary-button">
              <span class="play-icon">▶</span>
              Ver ejemplo en vivo
            </a>
          </div>

          <div class="metrics" aria-label="Capacidades técnicas">
            <div>
              <span class="metric-value">±20 mm</span>
              <span>Precisión dimensional</span>
            </div>
            <div>
              <span class="metric-value">100K m²</span>
              <span>Capacidad de captura</span>
            </div>
            <div>
              <span class="metric-value">48 hrs</span>
              <span>Entrega preliminar</span>
            </div>
          </div>
        </div>

        <HeroViewer client:visible />
      </div>
    </section>
    <!-- Agrega esta sección justo debajo de tu <main> o dentro del index.astro actual -->
    <section class="industries-preview-section">
      <div class="industries-inner">
        <div class="section-heading">
          <div>
            <span class="section-kicker">
              <i></i>
              Sectores de aplicación
            </span>
            <h2>Infraestructura crítica digitalizada con precisión.</h2>
          </div>
          <p>
            Soluciones adaptadas a los requerimientos normativos y de ingeniería de cada sector industrial.
          </p>
        </div>

        <div class="industries-grid">
          <div class="industry-card">
            <span>01</span>
            <h3>Plantas de Proceso e Industriales</h3>
            <p>Modelado de tuberías, isométricos y equipos críticos con AutoCAD Plant 3D.</p>
          </div>
          <div class="industry-card">
            <span>02</span>
            <h3>Arquitectura y Edificación Comercial</h3>
            <p>Levantamientos As-Built y planos arquitectónicos listos para remodelación.</p>
          </div>
          <div class="industry-card">
            <span>03</span>
            <h3>Energía e Instalaciones Críticas</h3>
            <p>Tours virtuales inmersivos para auditorías y control remoto de espacios.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="company-stats-section">
      <div class="stats-inner">
        <div class="stats-header">
          <span class="section-kicker">
            <i></i>
            Perfil de la empresa
          </span>
          <h2>Ingeniería y precisión respaldada por experiencia.</h2>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">+100k</span>
            <b>Metros cuadrados escaneados</b>
            <p>Experiencia comprobada en levantamientos de plantas industriales e infraestructuras complejas.</p>
          </div>

          <div class="stat-card">
            <span class="stat-number">±20mm</span>
            <b>Tolerancia milimétrica</b>
            <p>Garantía de precisión absoluta en cada nube de puntos y modelo As-Built entregado.</p>
          </div>

          <div class="stat-card">
            <span class="stat-number">100%</span>
            <b>Compatibilidad CAD / BIM</b>
            <p>Flujos de trabajo nativos optimizados para AutoCAD, AutoCAD Plant 3D y software BIM.</p>
          </div>

          <div class="stat-card">
            <span class="stat-number">48h</span>
            <b>Respuesta y entregas</b>
            <p>Agilidad en el procesamiento de datos para cumplir con los plazos críticos de sus proyectos.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .industries-preview-section {
    padding: 4rem 1.5rem;
    border-top: 1px solid #202a33;
    background: #090e14;
  }
  .industries-inner {
    width: min(100%, 1240px);
    margin: 0 auto;
  }
  .industries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .industry-card {
    padding: 28px;
    border: 1px solid #27323c;
    background: rgba(13, 20, 28, 0.7);
  }
  .industry-card span {
    color: #ff6816;
    font: 600 12px/1 "IBM Plex Mono", monospace;
  }
  .industry-card h3 {
    margin: 14px 0 8px;
    color: #edf1f5;
    font-size: 18px;
  }
  .industry-card p {
    margin: 0;
    color: #7f8a96;
    font-size: 13px;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .industries-grid { grid-template-columns: 1fr; }
  }
  /* Estilos para Sección de Datos / Estadísticas */
.company-stats-section {
  padding: 4rem 1.5rem;
  border-top: 1px solid #202a33;
  background: #090f16;
}
.stats-inner {
  width: min(100%, 1240px);
  margin: 0 auto;
}
.stats-header {
  max-width: 600px;
  margin-bottom: 40px;
}
.stats-header h2 {
  margin: 8px 0 0;
  color: #edf2f6;
  font-size: clamp(28px, 3vw, 38px);
  font-weight: 600;
  letter-spacing: -0.03em;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.stat-card {
  padding: 24px;
  border: 1px solid #27323c;
  background: rgba(13, 20, 28, 0.8);
}
.stat-number {
  display: block;
  color: #ff6816;
  font: 600 32px/1 "IBM Plex Mono", monospace;
  letter-spacing: -0.02em;
}
.stat-card b {
  display: block;
  margin: 14px 0 8px;
  color: #dbe2e7;
  font-size: 14px;
}
.stat-card p {
  margin: 0;
  color: #7f8a96;
  font-size: 12px;
  line-height: 1.6;
}

/* Estilos para Snippet "Sobre Nosotros" alternativo */
.about-snippet-section {
  padding: 4rem 1.5rem;
  border-top: 1px solid #202a33;
  background: #090f16;
}
.about-inner {
  width: min(100%, 1240px);
  margin: 0 auto;
}
.about-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 50px;
  align-items: center;
}
.about-copy h2 {
  margin: 8px 0 16px;
  color: #edf2f6;
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 600;
  line-height: 1.15;
}
.about-copy p {
  color: #7f8a96;
  font-size: 15px;
  line-height: 1.75;
  margin: 0 0 24px;
}
.about-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.about-badges span {
  padding: 6px 12px;
  border: 1px solid #2b3640;
  color: #aab4bd;
  background: #111a23;
  font: 500 10px/1 "IBM Plex Mono", monospace;
}
.about-highlight-box {
  display: grid;
  gap: 16px;
  padding: 28px;
  border: 1px solid #27323c;
  background: rgba(13, 20, 28, 0.9);
}
.highlight-item b {
  display: block;
  color: #ff6816;
  font: 600 12px/1 "IBM Plex Mono", monospace;
  margin-bottom: 6px;
}
.highlight-item p {
  margin: 0;
  color: #89949f;
  font-size: 13px;
  line-height: 1.5;
}

@media (max-width: 900px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .about-grid { grid-template-columns: 1fr; gap: 30px; }
}
@media (max-width: 560px) {
  .stats-grid { grid-template-columns: 1fr; }
}
</style>